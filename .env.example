# ────────────────────────────────────────────────────────────────
#  Application
# ────────────────────────────────────────────────────────────────
APP_NAME="Developer Landing API"
APP_ENV=development            # development | production
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins.
# Use "*" only for local development.
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000

# ────────────────────────────────────────────────────────────────
#  Storage / logging (relative paths are resolved from project root)
# ────────────────────────────────────────────────────────────────
DATA_DIR=data
LOG_FILE=data/logs/app.log
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────────
#  Rate limiting (file-based, per client IP, sliding window)
# ────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ────────────────────────────────────────────────────────────────
#  AI provider (Anthropic)
#  If ANTHROPIC_API_KEY is empty, the service still works: the AI
#  step degrades gracefully to a rule-based fallback.
# ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional: custom API base URL for a proxy / gateway (leave empty for the
# official https://api.anthropic.com).
ANTHROPIC_BASE_URL=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=12
AI_ENABLED=true

# ────────────────────────────────────────────────────────────────
#  Email (SMTP). Leave SMTP_HOST empty to run in "console" dry-run
#  mode — messages are logged instead of sent, and the API keeps
#  working. Fill these in to actually deliver mail.
# ────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true             # true = STARTTLS on 587, false + port 465 = implicit TLS
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Developer Portfolio"

# Where owner notifications are delivered.
OWNER_EMAIL=owner@example.com
