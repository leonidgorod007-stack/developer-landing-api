APP_NAME="Developer Landing API"
APP_ENV=development
DEBUG=true
RELOAD=false
HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000

DATA_DIR=data
LOG_FILE=data/logs/app.log
LOG_LEVEL=INFO

RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Proxy for AI calls: empty = direct, ignoring system proxy (works with a VPN/proxy on);
# "system" = use OS proxy settings; or a URL like http://host:port
ANTHROPIC_PROXY=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=12
AI_ENABLED=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Developer Portfolio"
OWNER_EMAIL=owner@example.com
